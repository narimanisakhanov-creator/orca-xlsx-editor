{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-catalog.v2.schema.json",
  "catalogVersion": 2,
  "name": "XLSX Editor",
  "owner": "narimanisakhanov-creator",
  "plugins": [
    {
      "id": "narimanisakhanov-creator.xlsx-editor",
      "source": {
        "kind": "git",
