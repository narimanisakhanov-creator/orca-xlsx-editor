{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-catalog.v2.schema.json",
  "catalogVersion": 2,
  "name": "XLSX Editor",
  "owner": "narimanisakhanov-creator",
  "plugins": [
    {
      "id": "narimanisakhanov-creator.xlsx-editor",
      "source": {
        "kind": "git",
        "url": "https://github.com/narimanisakhanov-creator/orca-xlsx-editor",
        "ref": "main"
      },
      "description": "Open and edit Excel workbooks in Orca with their formatting: fills, fonts, borders, number formats, merged cells, frozen panes and every sheet. Insert or delete rows and columns with formulas and references updated safely, search the whole workbook, and copy with formatting. Saves in place without touching the parts it did not edit. Hands a selection to an agent in your workspace as a Markdown table or TSV.",
      "categories": [
        "editors"
      ],
      "releases": [
        {
          "version": "1.1.5",
          "commit": "cd9285b205f73c86bd20360984613423094832ba",
          "contentHash": "06b4fd4336c0780cfbd36d5ed8bd06ed0135627807fdffc96ff9e967afc46def",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "XLSX Editor",
          "license": "MIT",
          "contributes": [
            {
              "kind": "customEditors",
              "name": "Workbook",
              "detail": ".xlsx, .xlsm"
            }
          ],
          "fileTypes": [
            "xlsx",
            "xlsm"
          ],
          "editorFileTypes": [
            "xlsx",
            "xlsm"
          ],
          "images": {
            "icon": {
              "path": "images/icon.png",
              "alt": "XLSX Editor",
              "sha256": "e7c8035ce082ae1d23f9224187c0ff283ccf9c43587ff95d67c2f3444faea079",
              "width": 256,
              "height": 256
            },
            "cover": {
              "path": "images/cover.png",
              "alt": "A ledger workbook in the editor: painted header, banded rows with borders, currency and percentage columns, frozen panes, and the copy and export controls",
              "sha256": "b76456fc3c655aa858d1cd32f1dd552f79e5acd1ff7f94856b9863e4a28d57aa",
              "width": 1600,
              "height": 1000
            },
            "screenshots": [
              {
                "path": "images/screenshot.png",
                "alt": "A ledger with a painted header, alternating row fills, thin borders and formatted numbers",
                "sha256": "4cbc74c2e754e655fef173a797e0258cc7a6c3bd7f67914b95cc1f06163f4453",
                "width": 1369,
                "height": 867
              }
            ]
          }
        }
      ]
    }
  ]
}
