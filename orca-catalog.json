      },
      "description": "Open and edit Excel workbooks in Orca with their formatting: fills, fonts, borders, number formats, merged cells, frozen panes and every sheet. Saves in place without touching the parts it did not edit. Hands a selection or a sheet to an agent in your workspace as a Markdown table or TSV.",
      "categories": [
        "editors"
      ],
      "releases": [
        {
          "version": "1.1.2",
          "commit": "fde13d746eb1df6122ff7d48732ad5f577c6d537",
          "contentHash": "f1a94db882d1340c02e584cb134c70b91efe8442875af74a92240fc8e449e562",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "XLSX Editor",
          "license": "MIT",
          "contributes": [
            {
              "kind": "customEditors",
              "name": "Workbook",
              "detail": ".xlsx, .xlsm"
            }
          ],
          "fileTypes": [
            "xlsx",
            "xlsm"
          ],
          "editorFileTypes": [
            "xlsx",
            "xlsm"
          ],
          "images": {
