# Dependencies
node_modules/

# Orca's generated typings for this plugin.
.orca/

# Development scratch.
.audit/
demo/dist/
*.local

# editor/assets/ is deliberately NOT ignored: the built bundle, stylesheet and vendored ExcelJS are
# what a plugin installed from this repository loads. Without them the editor frame stays empty.
# Run `npm run build` before committing so `npm run check:dist` stays green.

# Verification captures, not part of the plugin.
installed-*.png

# The workbook fixtures are built by test/helpers/build-fixtures.mjs at test time; a public plugin
# repository carries no spreadsheet binaries, which is why the catalog rejected the previous ones.
/test/fixtures/*.xlsx
/test/fixtures/*.xlsm
/test/fixtures/*.bin
/test/fixtures/*.tmp
